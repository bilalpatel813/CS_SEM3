
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE web-app PUBLIC
        "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
        "http://java.sun.com/dtd/web-app_2_3.dtd" >
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xal="https://www.w3.org/2001/XMLSchema-instance"
         xsl:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta-ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
  <servlet>
    <servlet-name>ConfigContext</servlet-name>
    <servlet-class>
     com.example.ConfigContextServlet
    </servlet-class>
    <init-param>
      <param-name>studentName</param-name>
      <param-value>Harsh</param-value>
    </init-param>
  </servlet>
  <servlet-mapping>
    <servlet-name>ConfigContext</servlet-name>
    <url-pattern>/config</url-pattern>
  </servlet-mapping>
</web-app>
